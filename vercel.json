{
  "version": 2,
  "builds": [
    {
      "src": "portfolio_core/wsgi.py",
      "use": "@vercel/python"
    }
  ],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "portfolio_core/wsgi.py"
    }
  ]
}
