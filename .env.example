# Django Security & Core Settings
DJANGO_SECRET_KEY=your-strong-random-secret-key-here
DJANGO_DEBUG=False
ALLOWED_HOSTS=.vercel.app,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://*.vercel.app

# Database Configuration (Optional: defaults to SQLite if not provided, or PostgreSQL e.g. from Neon/Supabase)
# DATABASE_URL=postgresql://username:password@hostname:port/dbname

# Email Configuration (Optional: for Contact form dispatch)
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_specific_password
DEFAULT_FROM_EMAIL=Personal Portfolio <your_email@gmail.com>
